OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Explicit selection: openai or cloudflare. Selecting Cloudflare never falls back to OpenAI.
STUDYFLOW_AI_PROVIDER=openai
# Use a Workers Free account; keep credentials only in local secrets / Render.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/google/gemma-4-26b-a4b-it
# Neon PostgreSQL: copy the pooled connection string into local secrets / Render.
STUDYFLOW_POSTGRES_URL=
STUDYFLOW_REQUIRE_POSTGRES=false
# Public URLs from the same branch with Neon Auth enabled.
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
STUDYFLOW_AI_USER_DAILY_LIMIT=20
STUDYFLOW_AI_GLOBAL_DAILY_LIMIT=100
